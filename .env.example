DJANGO_DEBUG=False
SECRET_KEY=change-this-to-a-long-random-secret-key
DJANGO_ALLOWED_HOSTS=portal.idealtechnos.com,your-render-app.onrender.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://portal.idealtechnos.com,https://your-render-app.onrender.com

# Render/Neon/Supabase PostgreSQL database URL.
# Example: postgresql://user:password@host/dbname
DATABASE_URL=
DATABASE_SSL_REQUIRE=True

# External production database, for example Wasmer-provisioned MySQL.
# Leave blank locally to use db.sqlite3.
# DATABASE_URL takes priority when set.
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USERNAME=
DB_PASSWORD=

# Cloud media storage for uploaded photos/images.
# Leave blank locally to use the media/ folder.
AWS_STORAGE_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_REGION_NAME=
AWS_S3_ENDPOINT_URL=
MEDIA_URL=

# Cloudinary media storage for Render/free hosting uploaded images.
# Example: cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_URL=

EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
CONTACT_EMAIL=
